<div class="menu-list">
  <a href="/certificados">Certificados de liberación<span>›</span></a>
  <a href="/productos">Productos y especificaciones<span>›</span></a>
  <a href="/pruebas">Pruebas de liberación<span>›</span></a>
  <% if (user.admin) { %><a href="/usuarios">Usuarios<span>›</span></a><% } %>
