<%- include('partials/header') %>
<div class="head">
  <h1>Productos y especificaciones</h1>
  <% if (user.role !== 'inspector') { %><a class="btn primary" href="/productos/nuevo">+ Nuevo producto</a><% } %>
</div>
<table class="grid">
  <thead><tr><th>Código</th><th>Producto</th><th>Ref.</th><th>Capacidad</th><th>Molde</th><th>Especificaciones</th><th>Estado</th></tr></thead>
  <tbody>
  <% for (const p of products) { %>
    <tr class="<%= p.active ? '' : 'inactive' %>">
      <td><a href="/productos/<%= p.id %>"><strong><%= p.code %></strong></a></td>
      <td><%= p.name %></td><td><%= p.referencia || '' %></td><td><%= p.capacidad || '' %></td><td><%= p.molde %></td>
      <td><%= p.n_specs %></td><td><%= p.active ? 'Activo' : 'Inactivo' %></td>
    </tr>
  <% } %>
  </tbody>
</table>

<section id="listas">
  <h2>Listas del lote</h2>
  <p class="muted">Opciones que aparecen al crear un lote. Escribe una por línea.</p>
  <% if (user.role !== 'inspector') { %>
  <form method="post" action="/listas" class="card narrow">
    <div class="row">
      <label>Colores <textarea name="colors" rows="8"><%= colors.join('\n') %></textarea></label>
      <label>Materiales <textarea name="materials" rows="8"><%= materials.join('\n') %></textarea></label>
    </div>
    <button class="btn primary">Guardar listas</button>
  </form>
  <% } else { %>
  <p>Colores: <%= colors.join(', ') %></p><p>Materiales: <%= materials.join(', ') %></p>
  <% } %>
</section>
<%- include('partials/footer') %>
