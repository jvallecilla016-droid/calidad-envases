<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %> · Calidad MulPlast</title>
<meta name="theme-color" content="#1f3b57">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Calidad MulPlast">
<link rel="manifest" href="/manifest.webmanifest?v=<%= v %>">
<link rel="icon" type="image/svg+xml" href="/static/icons/cg.svg?v=<%= v %>">
<link rel="icon" type="image/png" href="/static/icons/cg-32.png?v=<%= v %>">
<link rel="apple-touch-icon" href="/static/icons/cg-apple-180.png?v=<%= v %>">
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head>
<body class="<%= user ? 'auth' : '' %>">
<% if (user) { %>
<header class="top">
  <a class="brand" href="/"><img src="/static/icons/cg-32.png?v=<%= v %>" alt="" width="26" height="26" class="logo"><strong>Calidad</strong> <span><%= company %></span></a>
  <nav class="desk">
    <a href="/">Lotes</a>
    <a href="/indicadores">Indicadores</a>
    <a href="/certificados">Certificados</a>
    <a href="/productos">Productos</a>
    <a href="/pruebas">Pruebas</a>
    <% if (user.admin) { %><a href="/usuarios">Usuarios</a><% } %>
  </nav>
  <div class="who">
    <a href="/cuenta"><%= user.full_name %></a> <small><%= ROLE_NAMES[user.role] %></small>
    <form method="post" action="/logout" class="inline"><button class="link">Salir</button></form>
  </div>
</header>
<nav class="tabbar" aria-label="Menú principal">
  <a href="/" class="<%= typeof tab !== 'undefined' && tab === 'lotes' ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Lotes</a>
  <a href="/lotes/nuevo" class="add"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Nuevo</a>
  <a href="/indicadores" class="<%= typeof tab !== 'undefined' && tab === 'indicadores' ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7"/></svg>Indicadores</a>
  <a href="/menu" class="<%= typeof tab !== 'undefined' && tab === 'menu' ? 'on' : '' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>Más</a>
</nav>
<% } %>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
