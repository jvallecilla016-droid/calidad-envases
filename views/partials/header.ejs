<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Calidad</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<% if (user) { %>
<header class="top">
  <div class="brand"><strong>Calidad</strong> <span><%= company %></span></div>
  <nav>
    <a href="/">Lotes</a>
    <a href="/indicadores">Indicadores</a>
    <a href="/certificados">Certificados</a>
    <a href="/productos">Productos</a>
    <a href="/pruebas">Pruebas</a>
    <% if (user.role === 'jefe') { %><a href="/usuarios">Usuarios</a><% } %>
  </nav>
  <div class="who">
    <a href="/cuenta"><%= user.full_name %></a> <small><%= ROLE_NAMES[user.role] %></small>
    <form method="post" action="/logout" class="inline"><button class="link">Salir</button></form>
  </div>
</header>
<% } %>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
