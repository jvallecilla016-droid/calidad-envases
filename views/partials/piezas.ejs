<%# Color y material por pieza: cuerpo (cuñete o galón) y tapa. d = datos actuales del formulario o del lote. %>
<% const matSel = (name, cur) => `<select name="${name}" required><option value="">Seleccione…</option>${materials.map((o) => `<option${cur === o ? ' selected' : ''}>${o}</option>`).join('')}</select>`; %>
<fieldset class="piezas">
  <legend>Cuñete o galón</legend>
  <div class="row">
    <label>Color * <input name="color" value="<%= d.color || '' %>" maxlength="40" required placeholder="Ej.: blanco"></label>
    <label>Material * <%- matSel('material', d.material) %></label>
  </div>
</fieldset>
<fieldset class="piezas">
  <legend>Tapa</legend>
  <div class="row">
    <label>Color * <input name="lid_color" value="<%= d.lid_color || '' %>" maxlength="40" required placeholder="Ej.: azul rey"></label>
    <label>Material * <%- matSel('lid_material', d.lid_material) %></label>
  </div>
</fieldset>
