<%- include('partials/header') %>
<% const l = ev.lot; const draftKey = l.id + '-' + (sample ? sample.id : 'nueva'); %>
<a class="back" href="/lotes/<%= l.id %>">‹ Lote <%= l.lot_number %></a>
<h1><%= sample ? 'Editar' : 'Registrar' %> muestra <%= sampleNo %></h1>
<p class="muted"><%= l.product_name %> · <%= l.molde %>. Verde = dentro de LIC–LSC, rojo = fuera. Puedes usar coma decimal.</p>
<% if (error) { %><div class="flash error"><%= error %></div><% } %>
<p class="flash ok" id="draft-note" hidden>Recuperé lo que habías digitado y no alcanzaste a guardar.</p>
<form method="post" action="/lotes/<%= l.id %>/muestras<%= sample ? '/' + sample.id : '' %>" id="sample-form" data-draft="<%= draftKey %>" novalidate>
  <input type="hidden" name="sample_no" value="<%= sampleNo %>">
  <input type="hidden" name="draft" value="<%= draftKey %>">
  <% const singles = ev.specs.filter(s => !s.points); const multi = ev.specs.filter(s => s.points); %>
  <% if (singles.length) { %>
  <fieldset class="spec">
    <legend>Peso</legend>
    <div class="weights">
      <% for (const spec of singles) { const key = spec.id + '|'; %>
        <label class="w"><span><%= spec.characteristic %> <small><%= spec.lic %>–<%= spec.lsc %> <%= spec.unit %></small></span>
          <input class="meas" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="next" name="m_<%= spec.id %>_X" data-lic="<%= spec.lic %>" data-lsc="<%= spec.lsc %>" value="<%= values[key] ?? '' %>" required>
        </label>
      <% } %>
    </div>
  </fieldset>
  <% } %>
  <% for (const spec of multi) { %>
  <fieldset class="spec">
    <legend><%= spec.characteristic %> <small><%= spec.lic %>–<%= spec.lsc %> <%= spec.unit %></small></legend>
    <div class="points">
      <% for (const p of specPoints(spec)) { const key = spec.id + '|' + p; %>
        <label class="pt"><span><%= p %></span>
          <input class="meas" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="next" name="m_<%= spec.id %>_<%= p %>" data-lic="<%= spec.lic %>" data-lsc="<%= spec.lsc %>" value="<%= values[key] ?? '' %>" required aria-label="<%= spec.characteristic %> punto <%= p %>">
        </label>
      <% } %>
    </div>
  </fieldset>
  <% } %>
  <% if (!ev.specs.length) { %><p class="flash error">Este producto no tiene especificaciones. Pide al analista que las cargue en Productos.</p><% } %>
  <div class="savebar">
    <span id="live" class="live" aria-live="polite"></span>
    <button class="btn primary">Guardar muestra</button>
  </div>
</form>
<%- include('partials/footer') %>
