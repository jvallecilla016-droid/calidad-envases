<%- include('partials/header') %>
<% const l = ev.lot; const role = user.role; const open = l.status === 'en_proceso'; %>
<div class="head">
  <div>
    <h1>Lote <%= l.lot_number %> <span class="badge <%= l.status %>"><%= STATUS_NAMES[l.status] %></span></h1>
    <p class="muted"><%= l.product_name %> · <%= l.product_code %> · <%= l.molde %></p>
  </div>
  <% if (l.certificate_number) { %>
    <a class="btn primary" href="/certificados/<%= l.certificate_number %>.pdf?v=<%= v %>" target="_blank">Certificado <%= l.certificate_number %> (PDF)</a>
  <% } %>
</div>

<div class="cards">
  <div class="card">
    <h3>Datos del lote</h3>
    <dl>
      <dt>Fecha producción</dt><dd><%= l.production_date %></dd>
      <dt>Turno / máquina</dt><dd><%= [l.shift, l.machine].filter(Boolean).join(' / ') || '—' %></dd>
      <dt>Cantidad</dt><dd><%= l.quantity || '—' %></dd>
      <dt>Creado por</dt><dd><%= l.created_by_name %> · <%= l.created_at %></dd>
      <% if (l.submitted_by_name) { %><dt>Revisó</dt><dd><%= l.submitted_by_name %> · <%= l.submitted_at %></dd><% } %>
      <% if (l.decided_by_name) { %><dt><%= l.status === 'liberado' ? 'Aprobó' : 'Rechazó' %></dt><dd><%= l.decided_by_name %> · <%= l.decided_at %></dd><% } %>
      <% if (l.decision_notes) { %><dt>Decisión</dt><dd><%= l.decision_notes %></dd><% } %>
      <% if (l.notes) { %><dt>Observaciones</dt><dd><%= l.notes %></dd><% } %>
    </dl>
  </div>
  <div class="card verdict <%= ev.conforme ? 'ok' : (ev.complete ? 'bad' : 'pending') %>">
    <h3>Estado de conformidad</h3>
    <p class="big"><%= ev.conforme ? 'CUMPLE' : (ev.complete ? 'NO CUMPLE' : 'INCOMPLETO') %></p>
    <ul class="checks">
      <li class="<%= ev.measurementsOk ? 'ok' : 'bad' %>">Especificaciones: <%= ev.samples.length %> muestra(s), <%= ev.measurementsOk ? 'todas dentro de límites' : (ev.measurementsComplete ? 'con lecturas fuera de límites' : 'faltan datos') %></li>
      <li class="<%= ev.testsOk ? 'ok' : 'bad' %>">Pruebas: <%= ev.testsOk ? 'todas aprobadas' : (ev.testsComplete ? 'alguna no aprobada' : 'pendientes') %></li>
    </ul>
    <% if (ev.problems.length) { %>
      <details <%= ev.problems.length < 6 ? 'open' : '' %>><summary><%= ev.problems.length %> observación(es)</summary>
        <ul class="problems"><% for (const p of ev.problems) { %><li><%= p %></li><% } %></ul>
      </details>
    <% } %>
  </div>
</div>

<section>
  <div class="head">
    <h2>1. Especificaciones (resumen)</h2>
    <% if (open) { %><a class="btn primary" href="/lotes/<%= l.id %>/muestras/nueva">+ Registrar muestra</a><% } %>
  </div>
  <div class="hscroll"><table class="grid">
    <thead><tr><th>Característica</th><th>Unid.</th><th>Puntos</th><th>LIC</th><th>LCC</th><th>LSC</th><th>Lecturas</th><th>Mín</th><th>Máx</th><th>Prom.</th><th>Resultado</th></tr></thead>
    <tbody>
    <% for (const x of ev.specSummary) { %>
      <tr>
        <td><%= x.spec.characteristic %></td><td><%= x.spec.unit %></td><td><%= x.spec.points ? 'A–D' : '1' %></td>
        <td><%= x.spec.lic %></td><td><%= x.spec.lcc ?? '—' %></td><td><%= x.spec.lsc %></td>
        <td><%= x.n %></td>
        <td><%= x.min ?? '—' %></td><td><%= x.max ?? '—' %></td><td><%= x.avg === null ? '—' : x.avg.toFixed(2) %></td>
        <td><% if (!x.n) { %><span class="muted">Sin datos</span><% } else if (x.ok) { %><span class="tag ok">Conforme</span><% } else { %><span class="tag bad"><%= x.out %> fuera</span><% } %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% const minS = l.min_samples || 1; %>
  <p class="<%= ev.samples.length >= minS ? 'muted' : 'bad-text' %>">Muestras registradas: <strong><%= ev.samples.length %></strong> de mínimo <%= minS %> por lote<%= ev.samples.length < minS ? ` (faltan ${minS - ev.samples.length})` : '' %>.</p>

  <% for (const s of ev.samples) { %>
    <details class="sample">
      <summary>Muestra <%= s.sample_no %> · <%= s.taken_by_name %> · <%= s.taken_at %>
        <span class="tag <%= s.ok && s.complete ? 'ok' : 'bad' %>"><%= !s.complete ? 'Incompleta' : (s.ok ? 'Conforme' : 'No conforme') %></span></summary>
      <div class="hscroll"><table class="grid compact">
        <thead><tr><th>Característica</th><% for (const p of 'ABCD') { %><th><%= p %></th><% } %></tr></thead>
        <tbody>
        <% for (const spec of ev.specs) { %>
          <tr><td><%= spec.characteristic %> (<%= spec.unit %>)</td>
          <% if (spec.points) { for (const p of specPoints(spec)) { const v = s.values[spec.id + '|' + p]; %>
            <td class="<%= v ? (v.ok ? 'in' : 'out') : '' %>"><%= v ? v.value : '—' %></td>
          <% } } else { const v = s.values[spec.id + '|']; %>
            <td colspan="8" class="<%= v ? (v.ok ? 'in' : 'out') : '' %>"><%= v ? v.value : '—' %></td>
          <% } %></tr>
        <% } %>
        </tbody>
      </table></div>
      <% if (open) { %>
        <div class="actions">
          <a class="btn small" href="/lotes/<%= l.id %>/muestras/<%= s.id %>/editar">Editar</a>
          <% if (role !== 'inspector') { %>
          <form method="post" action="/lotes/<%= l.id %>/muestras/<%= s.id %>/eliminar" class="inline" onsubmit="return confirm('¿Eliminar la muestra <%= s.sample_no %>?')"><button class="btn small danger">Eliminar</button></form>
          <% } %>
        </div>
      <% } %>
    </details>
  <% } %>
</section>

<section>
  <h2>2. Pruebas de liberación</h2>
  <div class="tests-wrap"><table class="grid tests">
    <thead><tr><th>Prueba</th><th>Resultado</th><th>Observaciones</th><th>Realizó</th><% if (open) { %><th>Registrar</th><% } %></tr></thead>
    <tbody>
    <% for (const t of ev.tests) { const r = t.result; %>
      <tr>
        <td><strong><%= t.type.name %></strong><% if (!t.type.active) { %> <small class="muted">(inactiva)</small><% } %></td>
        <td><% if (!r) { %><span class="muted">Pendiente</span><% } else { const groups = r.detail ? r.detail.split(';') : []; const names = t.type.items ? t.type.items.split(',') : null; const many = groups.length > 1; %><span class="tag <%= r.result === 'pasa' ? 'ok' : 'bad' %>"><%= r.result === 'pasa' ? 'APROBADO' : 'NO APROBADO' %></span><% if (many && groups.length < (t.type.units || 1)) { %> <small class="bad-text">faltan <%= (t.type.units || 1) - groups.length %> envases</small><% } %>
          <% groups.forEach((g, ui) => { const d = g.split(','); if (!many && !t.type.checks) return; %>
          <div class="impactos"><% if (many) { %><b>E<%= ui + 1 %></b><% } %><% d.forEach((v, i) => { %><span class="<%= v === '1' ? 'si' : 'no' %>"><% if (names) { %><%= names[i] || i + 1 %>: <%= v === '1' ? 'no' : 'sí' %><% } else if (t.type.checks) { const f = d.indexOf('0'); %><%= i + 1 %>: <%= f !== -1 && i >= f ? '✗' : '✓' %><% } else { %><%= v === '1' ? '✓ Aprobado' : '✗ No aprobado' %><% } %></span><% }) %></div>
          <% }) %><% } %></td>
        <td><%= r ? (r.observations || '') : '' %></td>
        <td><%= r ? r.performed_by_name + ' · ' + r.performed_at : '' %></td>
        <% if (open) { %>
        <td>
          <% if (t.type.active) { %>
          <form method="post" action="/lotes/<%= l.id %>/pruebas" class="test-form">
            <input type="hidden" name="test_type_id" value="<%= t.type.id %>">
            <% const units = t.type.units || 1; const prevG = r && r.detail ? r.detail.split(';') : []; const names = t.type.items ? t.type.items.split(',') : null; %>
            <% if (t.type.checks > 0) { %>
            <% for (let u = 1; u <= units; u++) { const prev = prevG[u - 1] ? prevG[u - 1].split(',') : []; %>
            <fieldset class="checklist" data-min="<%= t.type.min_ok || t.type.checks %>" data-kind="<%= names ? 'defectos' : 'impactos' %>">
              <legend><%= units > 1 ? `Envase ${u} de ${units}. ` : '' %><%= names ? '¿El producto tiene este defecto? Se aprueba solo si no tiene ninguno' : `¿Resistió cada caída? Se aprueba si resiste mínimo ${t.type.min_ok || t.type.checks} caídas. Si falla una, las siguientes quedan como falladas` %></legend>
              <% for (let i = 1; i <= t.type.checks; i++) { const label = names ? (names[i - 1] || `Defecto ${i}`) : `Impacto ${i}`; %>
              <div class="chk-row">
                <span class="chk-n"><%= label %></span>
                <div class="seg2" role="radiogroup" aria-label="<%= units > 1 ? `Envase ${u}, ` : '' %><%= label %>">
                  <label class="opt ok"><input type="radio" name="chk_<%= u %>_<%= i %>" value="si" required <%= prev[i - 1] === '1' ? 'checked' : '' %>><span><%= names ? '✓ No tiene' : '✓ Resistió' %></span></label>
                  <label class="opt bad"><input type="radio" name="chk_<%= u %>_<%= i %>" value="no" <%= prev[i - 1] === '0' ? 'checked' : '' %>><span><%= names ? '✗ Sí tiene' : '✗ Falló' %></span></label>
                </div>
              </div>
              <% } %>
              <p class="chk-total muted" aria-live="polite"></p>
            </fieldset>
            <% } %>
            <% } else { %>
            <fieldset class="units">
              <% if (units > 1) { %><legend>Resultado de cada envase (<%= units %>)</legend><% } %>
              <% for (let u = 1; u <= units; u++) { const prev = prevG[u - 1] !== undefined ? prevG[u - 1] : (r && !r.detail ? (r.result === 'pasa' ? '1' : '0') : null); %>
              <div class="chk-row">
                <% if (units > 1) { %><span class="chk-n">Envase <%= u %></span><% } %>
                <div class="seg2" role="radiogroup" aria-label="Resultado de <%= t.type.name %><%= units > 1 ? `, envase ${u}` : '' %>">
                  <label class="opt ok"><input type="radio" name="res_<%= u %>" value="pasa" required <%= prev === '1' ? 'checked' : '' %>><span>Aprobado</span></label>
                  <label class="opt bad"><input type="radio" name="res_<%= u %>" value="no_pasa" <%= prev === '0' ? 'checked' : '' %>><span>No aprobado</span></label>
                </div>
              </div>
              <% } %>
            </fieldset>
            <% } %>
            <input name="observations" placeholder="Observaciones" value="<%= r ? (r.observations || '') : '' %>">
            <button class="btn small">Guardar</button>
          </form>
          <% } %>
        </td>
        <% } %>
      </tr>
    <% } %>
    </tbody>
  </table></div>
</section>

<section>
  <h2>3. Liberación</h2>
  <% if (l.status === 'en_proceso' || l.status === 'en_revision') { %>
    <div class="card narrow">
      <form method="post" action="/lotes/<%= l.id %>/liberar">
        <label>Observaciones de liberación (opcional) <input name="decision_notes"></label>
        <button class="btn primary wide" <%= ev.conforme ? '' : 'disabled' %>>Emitir certificado de calidad</button>
        <% if (!ev.conforme) { %><p class="muted">Se habilita cuando el lote tiene todas sus muestras y pruebas, y todo cumple. Revisa las observaciones de arriba.</p>
        <% } else { %><p class="muted">Recibe su consecutivo y queda listo para imprimir. El jefe de calidad lo verá para su visto bueno.</p><% } %>
      </form>
    </div>
    <% if (role === 'jefe') { %>
      <form method="post" action="/lotes/<%= l.id %>/rechazar" class="card narrow">
        <label>Rechazar el lote (motivo) <input name="decision_notes" required></label>
        <p class="muted">Antes de rechazar, agrega las fotos de evidencia en la sección 4. Salen en el informe de rechazo.</p>
        <button class="btn danger">Rechazar lote</button>
      </form>
    <% } %>
    <% if (l.status === 'en_revision' && role !== 'inspector') { %>
      <form method="post" action="/lotes/<%= l.id %>/devolver" class="inline"><button class="btn small">Devolver a proceso para corregir</button></form>
    <% } %>
  <% } else if (l.status === 'liberado') { %>
    <p>Lote liberado con el certificado <strong><%= l.certificate_number %></strong>.</p>
    <a class="btn primary" href="/certificados/<%= l.certificate_number %>.pdf?v=<%= v %>" target="_blank">Imprimir certificado</a>
  <% } else { %>
    <p>Lote rechazado. Motivo: <%= l.decision_notes %></p>
    <a class="btn primary" href="/lotes/<%= l.id %>/informe.pdf?v=<%= v %>&f=<%= photos.length %>" target="_blank">Informe de rechazo (PDF)</a>
  <% } %>
</section>

<section id="evidencia">
  <h2>4. Evidencia fotográfica</h2>
  <p class="muted">Fotos del defecto para soportar el rechazo. Máximo <%= MAX_PHOTOS %> por lote.</p>
  <% if (photos.length) { %>
  <div class="photos">
    <% photos.forEach(function (p, i) { %>
    <figure>
      <a href="/fotos/<%= p.id %>" target="_blank"><img src="/fotos/<%= p.id %>" alt="Foto <%= i + 1 %>" loading="lazy"></a>
      <figcaption><strong>Foto <%= i + 1 %></strong><%= p.caption ? ': ' + p.caption : '' %><br><span class="muted"><%= p.taken_by_name %> · <%= p.created_at %></span></figcaption>
      <% if (l.status !== 'liberado' && role !== 'inspector') { %>
      <form method="post" action="/fotos/<%= p.id %>/eliminar" data-confirm="¿Eliminar esta foto?"><button class="btn small">Eliminar</button></form>
      <% } %>
    </figure>
    <% }) %>
  </div>
  <% } else { %><p class="muted">Sin fotos.</p><% } %>
  <% if (l.status !== 'liberado' && photos.length < MAX_PHOTOS) { %>
  <form method="post" action="/lotes/<%= l.id %>/fotos" class="card narrow" id="photo-form">
    <label>Foto <input type="file" accept="image/*" capture="environment" id="photo-file" required></label>
    <img id="photo-preview" alt="" hidden>
    <label>Descripción (opcional) <input name="caption" maxlength="200" placeholder="Ej.: envase roto en la base"></label>
    <input type="hidden" name="photo" id="photo-data">
    <button class="btn primary wide" id="photo-btn">Guardar foto</button>
  </form>
  <% } %>
</section>

<% if (user.admin) { %>
<section>
  <details class="danger-zone">
    <summary>Eliminar este lote</summary>
    <form method="post" action="/lotes/<%= l.id %>/eliminar" class="card narrow">
      <p>Se borran el lote, sus muestras, mediciones y pruebas<%= l.certificate_number ? `, y el certificado ${l.certificate_number}` : '' %>. No se puede deshacer.</p>
      <label>Para confirmar, escribe el número de lote <strong><%= l.lot_number %></strong>
        <input name="confirm" required autocomplete="off"></label>
      <button class="btn danger">Eliminar lote</button>
    </form>
  </details>
</section>
<% } %>
<%- include('partials/footer') %>
