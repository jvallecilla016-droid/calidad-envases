<%- include('partials/header') %>
<h1>Usuarios</h1>
<p class="muted">Perfiles: <strong>Aprendiz / Operario</strong> registra muestras y pruebas y emite el certificado cuando el lote cumple. <strong>Auxiliar de calidad</strong> además mantiene productos y pruebas. <strong>Jefe de calidad</strong> además da el visto bueno a los certificados y rechaza lotes. Solo el administrador (Luis Eduardo Gómez) crea, modifica y elimina usuarios y elimina lotes.</p>
<p class="muted">«Eliminar» borra al usuario si no tiene registros de calidad. Si ya registró lotes, muestras o pruebas, queda desactivado para no perder quién hizo cada cosa.</p>
<table class="grid">
  <thead><tr><th>Usuario</th><th>Nombre</th><th>Perfil</th><th>Activo</th><th>Nueva contraseña</th><th></th></tr></thead>
  <tbody>
  <% for (const u of users) { %>
    <tr class="<%= u.active ? '' : 'inactive' %>">
      <td><code><%= u.username %></code></td>
      <td><input form="u<%= u.id %>" name="full_name" value="<%= u.full_name %>" required></td>
      <td><select form="u<%= u.id %>" name="role"><% for (const [k, v] of Object.entries(ROLE_NAMES)) { %><option value="<%= k %>" <%= u.role === k ? 'selected' : '' %>><%= v %></option><% } %></select></td>
      <td><input form="u<%= u.id %>" type="checkbox" name="active" value="1" <%= u.active ? 'checked' : '' %>></td>
      <td><input form="u<%= u.id %>" type="password" name="password" minlength="8" placeholder="(sin cambio)" autocomplete="new-password"></td>
      <td class="user-actions"><form id="u<%= u.id %>" method="post" action="/usuarios/<%= u.id %>"><button class="btn small">Guardar</button></form>
        <% if (u.id !== user.id) { %><form method="post" action="/usuarios/<%= u.id %>/eliminar" data-confirm="¿Eliminar el usuario <%= u.username %> (<%= u.full_name %>)?"><button class="btn small danger">Eliminar</button></form><% } %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<form method="post" action="/usuarios" class="card narrow">
  <h2>Crear usuario</h2>
  <label>Usuario (para ingresar) * <input name="username" required pattern="[a-zA-Z0-9._\-]{3,30}"></label>
  <label>Nombre completo * <input name="full_name" required></label>
  <label>Perfil * <select name="role"><% for (const [k, v] of Object.entries(ROLE_NAMES)) { %><option value="<%= k %>"><%= v %></option><% } %></select></label>
  <label>Contraseña inicial (mínimo 8) * <input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
  <button class="btn primary">Crear</button>
</form>
<%- include('partials/footer') %>
